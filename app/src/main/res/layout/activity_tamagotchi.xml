<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <!-- Шапка + питомец в одной карточке -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTgTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/vdTgDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/dot_bg" />

                <TextView
                    android:id="@+id/tvTgStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.clawd.pet.PetPreviewView
                android:id="@+id/tgPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Статы: тонкие полосы -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTgMood"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/pbTgMood"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:max="10"
                    android:progress="10"
                    android:progressDrawable="@drawable/bar_track" />

                <TextView
                    android:id="@+id/tvTgMoodVal"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTgHunger"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/pbTgHunger"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:max="10"
                    android:progress="10"
                    android:progressDrawable="@drawable/bar_track" />

                <TextView
                    android:id="@+id/tvTgHungerVal"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTgEnergy"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/pbTgEnergy"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:max="10"
                    android:progress="10"
                    android:progressDrawable="@drawable/bar_track" />

                <TextView
                    android:id="@+id/tvTgEnergyVal"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Действия -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTgFeed"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTgPlay"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTgSleep"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Мини-игры: ряд 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTgGame1"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTgGame2"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTgGame3"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTgGame4"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Мини-игры: ряд 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTgGame5"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTgGame6"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTgGame7"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTgGame8"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_soft"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Вторая жизнь -->
        <LinearLayout
            android:id="@+id/tgReviveBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTgHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/etTgCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/accent"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTgRevive"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/ripple_accent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
